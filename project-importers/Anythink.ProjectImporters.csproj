<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Anythink.ProjectImporters</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Anythink.ProjectImporters</PackageId>
    <Version>1.0.0</Version>
    <Description>Import projects from other platforms into Anythink</Description>
    <Authors>Anythink</Authors>
    <PackageTags>anythink;import;migration;directus;supabase</PackageTags>
    <PackageProjectUrl>https://github.com/anythink-cloud/anythink-cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/anythink-cloud/anythink-cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AnythinkCli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
